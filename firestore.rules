rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi Stok Aksesoris
    match /stok_aksesoris/{accessoryId} {
      allow read, write: if true;
    }

    // Koleksi HP & IMEI
    match /hp_imei/{phoneId} {
      allow read, write: if true;

      // Sub-koleksi unit fisik / serial IMEI
      match /serials/{serialId} {
        allow read, write: if true;
      }
    }

    // Koleksi Staf & Pengguna (RBAC & Hybrid Auth)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Koleksi umum fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
